{
  "name": "proof-index-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare-catalog": "node scripts/prepare-catalog.mjs",
    "build": "npm run prepare-catalog && astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astro": "7.3.8",
    "katex": "0.19.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.5",
    "jsdom": "30.1.2",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
