---
import Base from "../layouts/Base.astro";
import SearchPanel from "./SearchPanel.astro";
import PaperList from "./PaperList.astro";
import Pagination from "./Pagination.astro";
import { taxonomy } from "../lib/catalog";
import type { ListPage } from "../lib/contracts";
import { pageHref } from "../lib/urls";
interface Props { page: ListPage; prefix: string; heading: string; title?: string; context?: string;
  view: "new" | "updated" | "archive" | "foundations"; intro?: string }
const { page, prefix, heading, title, context, view, intro } = Astro.props;
---
<Base title={title} canonicalPath={pageHref(prefix, page.page)}>
  <SearchPanel view={view} />
  {intro && <p class="paper-note">{intro}</p>}
  <PaperList page={page} taxonomy={taxonomy()} heading={heading} context={context} />
  <Pagination prefix={prefix} page={page.page} pageCount={page.page_count} />
</Base>
