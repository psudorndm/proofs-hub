---
import type { PublicPaper, Taxonomy } from "../lib/contracts";
import { ABSTRACT_UNAVAILABLE, labelFor, sourceLabel, AREA_CLASS } from "../lib/format";
import { formatPublished } from "../lib/dates";
import { withBase } from "../lib/urls";
import CitationButton from "./CitationButton.astro";
interface Props { paper: PublicPaper; taxonomy: Taxonomy; related: { id: string; title: string; path: string }[] }
const { paper, taxonomy, related } = Astro.props;
const contributions = paper.contributions.map((c) => labelFor(taxonomy, "contributions", c));
const REVIEW: Record<string, string> = {
  automatic: "Automatic (deterministic rules)",
  "agent-provisional": "Provisional curation (not yet reviewed by a person)",
  "human-reviewed": "Reviewed by a person",
};
const EVENT: Record<string, string> = {
  publication: "Original publication", source_added: "Source added", source_revision: "New source version",
  metadata_updated: "Metadata updated", withdrawn: "Withdrawn", restored: "Restored", curation: "Curation change",
};
---
<article class="detail" data-paper-id={paper.id}>
  <h1 data-math>{paper.title}</h1>
  <p class="paper-meta">{paper.authors.length ? paper.authors.map((a) => a.display_name).join(", ") : "Authors unavailable"}</p>
  <p class="paper-meta">{formatPublished(paper.published)}{paper.published.precision !== "day" && paper.published.precision !== "unknown" && <> (approximate: the sources give only a {paper.published.precision})</>}</p>
  <ul class="paper-tags">
    {paper.areas.map((a) => <li class={`badge ${AREA_CLASS[a]}`}>{labelFor(taxonomy, "areas", a)}</li>)}
    {paper.topics.map((t) => <li class="badge badge-topic"><a href={withBase(`topics/${t}/`)}>{labelFor(taxonomy, "topics", t)}</a></li>)}
    <li class="badge badge-contribution">{contributions.length ? contributions.join(" · ") : "Research paper"}</li>
    {paper.foundational && <li class="badge badge-foundational">Foundational</li>}
    {paper.status !== "active" && <li class="badge badge-status">{paper.status === "withdrawn" ? "Withdrawn" : "Unavailable at all known sources"}</li>}
  </ul>

  <section aria-labelledby="abstract-h">
    <h2 id="abstract-h">Abstract</h2>
    <p data-math>{paper.abstract ?? ABSTRACT_UNAVAILABLE}</p>
  </section>

  <section aria-labelledby="sources-h">
    <h2 id="sources-h">Sources</h2>
    <div class="table-wrap"><table>
      <thead><tr><th scope="col">Source</th><th scope="col">Identifier</th><th scope="col">Version</th><th scope="col">Status</th><th scope="col">Links</th></tr></thead>
      <tbody>
        {paper.sources.map((s) => (
          <tr>
            <td>{sourceLabel(s).split(" ")[0]}</td>
            <td class="mono">{s.provider === "eprint" ? sourceLabel(s).split(" ")[1] : s.source_id}</td>
            <td>{s.version ?? "—"}</td>
            <td>{s.status}</td>
            <td>
              {s.landing_url && <a href={s.landing_url} rel="noopener">{sourceLabel(s)} page</a>}
              {s.pdf_url && <> · <a href={s.pdf_url} rel="noopener">PDF</a></>}
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </section>

  {paper.publications.length > 0 && (
    <section aria-labelledby="pub-h">
      <h2 id="pub-h">Publication records</h2>
      <p class="paper-note">Listed from bibliographic metadata; a listing is not by itself evidence of peer review.</p>
      <ul>
        {paper.publications.map((p) => (
          <li>{p.venue_name ?? "Venue unknown"}{p.year && <> ({p.year})</>}{p.doi && <> · DOI <a href={`https://doi.org/${p.doi}`} rel="noopener" class="mono">{p.doi}</a></>}</li>
        ))}
      </ul>
    </section>
  )}

  {paper.code_links.length > 0 && (
    <section aria-labelledby="code-h">
      <h2 id="code-h">Code</h2>
      <ul>
        {paper.code_links.map((c) => (
          <li><a href={c.url} rel="noopener">{c.verified_official ? "Official code" : "Code link"}</a> <span class="paper-note">({c.verified_official ? "verified author-provided" : `from ${c.origin.replace("_", " ")}`})</span></li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="cite-h">
    <h2 id="cite-h">Cite</h2>
    <CitationButton bibtexPath={paper.bibtex_path} />
  </section>

  <section aria-labelledby="incl-h">
    <h2 id="incl-h">Why this paper is included</h2>
    <p>{paper.inclusion.explanation}</p>
    <p class="paper-note">Decision type: {REVIEW[paper.inclusion.review_status]}</p>
    {paper.inclusion.evidence.length > 0 && (
      <ul>
        {paper.inclusion.evidence.map((e) => (
          <li><span class="paper-note">{e.field}{e.rule_id && <> · rule <span class="mono">{e.rule_id}</span></>}:</span> “{e.snippet}”</li>
        ))}
      </ul>
    )}
    {paper.metadata_issues.length > 0 && <p class="paper-note">Metadata notes: {paper.metadata_issues.join(", ").replaceAll("_", " ")}</p>}
  </section>

  {related.length > 0 && (
    <section aria-labelledby="rel-h">
      <h2 id="rel-h">Related works</h2>
      <ul>{related.map((r) => <li><a href={r.path}>{r.title}</a></li>)}</ul>
    </section>
  )}

  <section aria-labelledby="hist-h">
    <h2 id="hist-h">History</h2>
    <ol>
      {paper.history.map((h) => (
        <li>{EVENT[h.kind] ?? h.kind}{h.date && <> · <time datetime={h.date}>{h.date}</time>{h.date_basis === "observed" && " (date observed by the index)"}</>}{h.source && <> · {h.source}</>}</li>
      ))}
    </ol>
  </section>
</article>
