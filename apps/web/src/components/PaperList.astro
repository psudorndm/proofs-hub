---
import type { ListPage, Taxonomy } from "../lib/contracts";
import PaperCard from "./PaperCard.astro";
import { abstractOf } from "../lib/catalog";
import { EMPTY_RESULTS } from "../lib/format";
import { withBase } from "../lib/urls";
interface Props { page: ListPage; taxonomy: Taxonomy; heading: string; context?: string }
const { page, taxonomy, heading, context } = Astro.props;
---
<section class="results" aria-labelledby="results-heading">
  <div class="list-head">
    <h2 id="results-heading">{heading}</h2>
    <p class="meta" aria-live="polite" data-result-count>
      {page.total} {page.total === 1 ? "paper" : "papers"}{context && <> · {context}</>}
    </p>
  </div>
  {page.items.length === 0 ? (
    <div class="empty"><p>{EMPTY_RESULTS}</p><p><a href={withBase("archive/")}>Browse the archive</a></p></div>
  ) : (
    <ol class="paper-list">
      {page.items.map((card) => <li><PaperCard card={card} taxonomy={taxonomy} abstract={abstractOf(card)} /></li>)}
    </ol>
  )}
</section>
