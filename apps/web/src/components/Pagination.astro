---
import { pageHref } from "../lib/urls";
interface Props { prefix: string; page: number; pageCount: number }
const { prefix, page, pageCount } = Astro.props;
---
{pageCount > 1 && (
  <nav class="pagination" aria-label="Pages">
    {page > 1 ? <a href={pageHref(prefix, page - 1)} rel="prev">Previous</a> : <span class="disabled">Previous</span>}
    <span aria-current="page">Page {page} of {pageCount}</span>
    {page < pageCount ? <a href={pageHref(prefix, page + 1)} rel="next">Next</a> : <span class="disabled">Next</span>}
  </nav>
)}
