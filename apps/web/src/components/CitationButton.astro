---
interface Props { bibtexPath: string }
const { bibtexPath } = Astro.props;
---
<div class="citation" data-bibtex={bibtexPath}>
  <a href={bibtexPath} download>Download BibTeX</a>
  <button type="button" class="secondary" data-copy-bibtex hidden>Copy BibTeX</button>
  <span role="status" aria-live="polite" data-copy-status></span>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>(".citation")) {
    const button = root.querySelector<HTMLButtonElement>("[data-copy-bibtex]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    if (!button || !status || !navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        const response = await fetch(root.dataset.bibtex ?? "");
        if (!response.ok) throw new Error(String(response.status));
        await navigator.clipboard.writeText(await response.text());
        status.textContent = "Copied.";
      } catch {
        status.textContent = "Copy failed. Use Download BibTeX instead.";
      }
    });
  }
</script>
