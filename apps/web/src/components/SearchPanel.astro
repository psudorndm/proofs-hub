---
import { taxonomy, manifest } from "../lib/catalog";
import { withBase } from "../lib/urls";
interface Props { view?: "new" | "updated" | "archive" | "foundations" | "search"; area?: string | null }
const { view = "new", area = null } = Astro.props;
const tax = taxonomy();
const m = manifest();
const views = [
  { id: "new", label: "New", href: withBase("") },
  { id: "updated", label: "Updated", href: withBase("updated/") },
  { id: "archive", label: "Archive", href: withBase("archive/") },
  { id: "foundations", label: "Foundations", href: withBase("foundations/") },
];
const areaTabs = [{ id: null, label: "All" }, ...tax.areas.map((a) => ({ id: a.id, label: a.display_name }))];
const sources = Object.keys(m.source_record_counts).sort();
---
<section class="search-panel" aria-label="Search and filters">
  <form action={withBase("search/")} method="get" role="search" data-search-form>
    <div class="search-row">
      <label for="q" class="visually-hidden">Search titles, authors, abstracts, or paper IDs</label>
      <input id="q" name="q" type="search" placeholder="Search titles, authors, abstracts, or paper IDs" autocomplete="off" />
      <button type="submit">Search</button>
    </div>
    <ul class="tabs" aria-label="Area">
      {areaTabs.map((t) => (
        <li><a href={t.id ? `${withBase("search/")}?area=${t.id}` : withBase("search/")} aria-current={view === "search" && t.id === null ? "true" : undefined} data-area={t.id ?? ""}>{t.label}</a></li>
      ))}
    </ul>
    <ul class="tabs" aria-label="View">
      {views.map((v) => <li><a href={v.href} aria-current={view === v.id ? "page" : undefined}>{v.label}</a></li>)}
    </ul>
    <details class="filters" data-filters>
      <summary>Filters</summary>
      <div class="filter-grid">
        <fieldset>
          <legend>Area</legend>
          {tax.areas.map((a) => <label><input type="checkbox" name="area" value={a.id} /> {a.display_name}</label>)}
        </fieldset>
        <fieldset>
          <legend>Source</legend>
          {sources.map((s) => <label><input type="checkbox" name="source" value={s} /> {s}</label>)}
        </fieldset>
        <fieldset>
          <legend>Contribution</legend>
          {tax.contributions.map((c) => <label><input type="checkbox" name="kind" value={c.id} /> {c.display_name}</label>)}
        </fieldset>
        <label class="block" for="topic">Topic
          <select id="topic" name="topic" multiple size="5">
            {tax.topics.map((t) => <option value={t.id}>{t.display_name}</option>)}
          </select>
        </label>
        <fieldset>
          <legend>Publication date</legend>
          <label>Window
            <select name="window">
              <option value="">All dates</option>
              <option value="7">Last 7 days</option>
              <option value="30">Last 30 days</option>
              <option value="365">Last 365 days</option>
            </select>
          </label>
          <label>From year <input type="number" name="year_from" min="1" max="9999" inputmode="numeric" /></label>
          <label>To year <input type="number" name="year_to" min="1" max="9999" inputmode="numeric" /></label>
          <label>From date <input type="date" name="date_from" /></label>
          <label>To date <input type="date" name="date_to" /></label>
          <label><input type="checkbox" name="exact_dates" value="1" /> Exact dates only</label>
        </fieldset>
        <fieldset>
          <legend>Other</legend>
          <label><input type="checkbox" name="code" value="1" /> Has code link</label>
          <label>Status
            <select name="status" multiple size="3">
              <option value="active">Active</option>
              <option value="withdrawn">Withdrawn</option>
              <option value="unavailable">Unavailable</option>
            </select>
          </label>
          <label>Sort
            <select name="sort">
              <option value="">Default</option>
              <option value="newest">Newest</option>
              <option value="oldest">Oldest</option>
              <option value="updated">Recently updated</option>
              <option value="relevance">Relevance</option>
            </select>
          </label>
        </fieldset>
        <p><button type="submit">Apply filters</button></p>
      </div>
    </details>
    <ul class="chips" data-chips aria-label="Active filters"></ul>
  </form>
</section>
