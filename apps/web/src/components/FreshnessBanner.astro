---
import { manifest } from "../lib/catalog";
import { PARTIAL_FRESHNESS, PREVIEW_LABEL } from "../lib/format";
const m = manifest();
const failing = m.sources.filter((s) => s.last_error_code || !s.last_success_at);
const lastSuccess = m.sources.map((s) => s.last_success_at).filter(Boolean).sort().at(-1) ?? null;
---
<div class="freshness" data-generated-at={m.generated_at} data-as-of={m.as_of_date}>
  {m.dataset_mode === "fixture" && (
    <div class="banner banner-preview" role="note"><p>{PREVIEW_LABEL}</p></div>
  )}
  <div class="banner">
    <p>
      Updated: <time datetime={m.as_of_date}>{m.as_of_date}</time>
      {lastSuccess ? <> · last successful source refresh {lastSuccess.slice(0, 10)}</> : <> · no source has completed a refresh yet</>}
      <span class="stale-note" data-stale-note hidden></span>
    </p>
    {m.coverage_status !== "complete" && (
      <p>Historical coverage is not yet complete. <a href={`${m.public_base_path}coverage/`}>See coverage</a>.</p>
    )}
  </div>
  {failing.length > 0 && m.dataset_mode === "live" && (
    <div class="banner banner-warn" role="status"><p>{PARTIAL_FRESHNESS}</p></div>
  )}
</div>
<script>
  // Client-side age: a static release can show it is stale even if no later deploy succeeds.
  import { ageDays, todayUTC } from "../lib/dates";
  const root = document.querySelector<HTMLElement>(".freshness");
  const note = document.querySelector<HTMLElement>("[data-stale-note]");
  if (root && note && root.dataset.asOf) {
    const age = ageDays(root.dataset.asOf, todayUTC());
    if (age >= 2) {
      note.textContent = ` · This index was last refreshed on ${root.dataset.asOf} (${age} days ago).`;
      note.hidden = false;
    }
  }
</script>
