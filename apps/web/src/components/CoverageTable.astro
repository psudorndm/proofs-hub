---
interface Row { stream_key: string; provider: string; kind: string; state: string; expected_count: number | null;
  seen_count: number; valid_count: number; quarantined_count: number; filtered_by_local_rule: number;
  last_success_at: string | null; last_error_code: string | null }
interface Props { rows: Row[] }
const { rows } = Astro.props;
const STATE: Record<string, string> = { not_started: "Not started", running: "Running", complete: "Complete", partial: "Partial", blocked: "Blocked" };
---
<div class="table-wrap"><table>
  <caption class="visually-hidden">Coverage by harvest stream</caption>
  <thead><tr>
    <th scope="col">Stream</th><th scope="col">State</th><th scope="col">Expected</th><th scope="col">Seen</th>
    <th scope="col">Valid</th><th scope="col">Quarantined</th><th scope="col">Filtered (local rule)</th><th scope="col">Last success</th>
  </tr></thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td class="mono">{r.stream_key}</td>
        <td>{STATE[r.state] ?? r.state}{r.last_error_code && <> · last error: {r.last_error_code.replaceAll("_", " ")}</>}</td>
        <td>{r.expected_count ?? "Not reported by provider"}</td>
        <td>{r.seen_count}</td><td>{r.valid_count}</td><td>{r.quarantined_count}</td><td>{r.filtered_by_local_rule}</td>
        <td>{r.last_success_at ? r.last_success_at.slice(0, 10) : "—"}</td>
      </tr>
    ))}
  </tbody>
</table></div>
