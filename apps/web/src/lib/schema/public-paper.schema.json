  "additionalProperties": false,
  "properties": {
    "abstract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Abstract"
    },
    "areas": {
      "items": {
        "enum": [
          "proof-systems",
          "security-proofs",
          "formal-verification"
