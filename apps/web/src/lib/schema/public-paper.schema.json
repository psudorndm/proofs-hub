      "type": "array"
    },
    "authors": {
      "items": {
        "$ref": "#/$defs/PublicAuthor"
      },
      "title": "Authors",
      "type": "array"
    },
    "bibtex_path": {
      "title": "Bibtex Path",
      "type": "string"
    },
    "canonical_path": {
      "title": "Canonical Path",
      "type": "string"
    },
    "code_links": {
      "items": {
        "$ref": "#/$defs/PublicCodeLink"
      },
      "title": "Code Links",
      "type": "array"
    },
    "contributions": {
      "items": {
        "enum": [
          "construction-theory",
          "analysis-attack",
          "implementation-optimization",
          "application",
          "survey-tutorial"
        ],
        "type": "string"
      },
      "title": "Contributions",
      "type": "array"
    },
    "foundational": {
      "title": "Foundational",
      "type": "boolean"
    },
    "history": {
      "items": {
        "$ref": "#/$defs/PublicEvent"
      },
      "title": "History",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "inclusion": {
      "$ref": "#/$defs/PublicInclusion"
    },
    "latest_update": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata_issues": {
      "items": {
        "type": "string"
      },
      "title": "Metadata Issues",
      "type": "array"
    },
    "publications": {
      "items": {
        "$ref": "#/$defs/PublicPublication"
      },
      "title": "Publications",
      "type": "array"
    },
    "published": {
      "$ref": "#/$defs/PartialDate"
    },
    "related_work_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Work Ids",
      "type": "array"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/PublicSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "active",
        "withdrawn",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "topics": {
      "items": {
        "type": "string"
      },
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "release_id",
    "id",
    "title",
    "authors",
    "abstract",
    "published",
    "areas",
    "topics",
    "contributions",
    "foundational",
    "status",
    "metadata_issues",
    "sources",
    "publications",
    "code_links",
    "latest_update",
    "inclusion",
    "related_work_ids",
    "canonical_path",
    "bibtex_path"
  ],
  "title": "PublicPaper",
  "type": "object"
}
