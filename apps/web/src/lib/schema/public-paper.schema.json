{
  "$defs": {
    "PartialDate": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Day"
        },
        "month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Month"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ],
          "title": "Precision",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year"
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "precision"
      ],
      "title": "PartialDate",
      "type": "object"
    },
    "PublicAuthor": {
