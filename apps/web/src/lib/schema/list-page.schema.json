{
  "$defs": {
    "PaperCard": {
      "additionalProperties": false,
      "description": "Small list projection: no full abstract, evidence, or history.",
      "properties": {
        "areas": {
          "items": {
            "enum": [
              "proof-systems",
              "security-proofs",
              "formal-verification"
            ],
            "type": "string"
          },
          "title": "Areas",
          "type": "array"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "bibtex_path": {
          "title": "Bibtex Path",
          "type": "string"
        },
        "canonical_path": {
          "title": "Canonical Path",
          "type": "string"
        },
        "contributions": {
          "items": {
            "enum": [
              "construction-theory",
              "analysis-attack",
              "implementation-optimization",
              "application",
              "survey-tutorial"
            ],
            "type": "string"
          },
          "title": "Contributions",
          "type": "array"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doi"
        },
        "foundational": {
          "title": "Foundational",
          "type": "boolean"
        },
        "has_abstract": {
          "title": "Has Abstract",
          "type": "boolean"
        },
        "has_code": {
          "title": "Has Code",
          "type": "boolean"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "json_path": {
          "title": "Json Path",
          "type": "string"
        },
        "latest_update": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicUpdate"
            },
            {
              "type": "null"
            }
          ]
        },
        "published": {
          "$ref": "#/$defs/PartialDate"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/PublicSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue"
        }
      },
      "required": [
        "id",
        "title",
        "authors",
        "published",
        "areas",
        "topics",
        "contributions",
        "foundational",
        "status",
        "sources",
        "venue",
        "doi",
        "has_code",
        "has_abstract",
        "latest_update",
        "canonical_path",
        "bibtex_path",
        "json_path"
      ],
      "title": "PaperCard",
      "type": "object"
    },
    "PartialDate": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Day"
        },
        "month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Month"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "unknown"
          ],
          "title": "Precision",
          "type": "string"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Year"
        }
      },
      "required": [
        "year",
        "month",
        "day",
        "precision"
      ],
      "title": "PartialDate",
      "type": "object"
    },
    "PublicSource": {
      "additionalProperties": false,
      "properties": {
        "landing_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Landing Url"
        },
        "pdf_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pdf Url"
        },
        "provider": {
          "enum": [
            "eprint",
            "arxiv",
            "dblp",
            "crossref",
            "curated"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "withdrawn",
            "deleted"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "provider",
        "source_id",
        "landing_url",
        "pdf_url",
        "version",
        "status"
      ],
      "title": "PublicSource",
      "type": "object"
    },
    "PublicUpdate": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "title": "Date",
          "type": "string"
        },
        "date_basis": {
          "enum": [
            "source",
            "observed"
          ],
          "title": "Date Basis",
          "type": "string"
        },
        "kind": {
          "enum": [
            "source_revision",
            "metadata_updated",
            "withdrawn",
            "restored"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Record Id"
        }
      },
      "required": [
        "kind",
        "date",
        "date_basis",
        "source_record_id"
      ],
      "title": "PublicUpdate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "As Of Date"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PaperCard"
      },
      "title": "Items",
      "type": "array"
    },
    "list": {
      "title": "List",
      "type": "string"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "page_count": {
      "title": "Page Count",
      "type": "integer"
    },
    "page_size": {
      "const": 25,
      "default": 25,
      "title": "Page Size",
      "type": "integer"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "window_days": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Days"
    }
  },
  "required": [
    "release_id",
    "list",
    "total",
    "page",
    "page_count",
    "items"
  ],
  "title": "ListPage",
  "type": "object"
}
