---
import ListView from "../../../components/ListView.astro";
import { listPages, manifest } from "../../../lib/catalog";
import { pagedPaths } from "../../../lib/paths";
import type { ListPage } from "../../../lib/contracts";
export function getStaticPaths() {
  return manifest().available_years.flatMap((year) => pagedPaths(listPages(`lists/archive/${year}`), { year }));
}
const { page, year } = Astro.props as { page: ListPage; year: string };
const label = year === "unknown" ? "Date unknown" : `Published in ${year}`;
---
<ListView page={page} prefix={`archive/${year}`} view="archive" title={label} heading={label} context="newest first" />
