---
import Base from "../../layouts/Base.astro";
import SearchPanel from "../../components/SearchPanel.astro";
import { listPages, manifest } from "../../lib/catalog";
import { withBase } from "../../lib/urls";
const m = manifest();
const years = m.available_years.map((y) => ({ year: y, total: listPages(`lists/archive/${y}`)[0]?.total ?? 0 }));
---
<Base title="Archive" canonicalPath={withBase("archive/")}>
  <SearchPanel view="archive" />
  <h2>Archive by publication year</h2>
  <p class="paper-note">Papers with only a publication year or month appear under that year. Papers whose date is unknown are listed separately.</p>
  {years.length === 0 ? <div class="empty"><p>No papers in this release.</p></div> : (
    <ul class="tabs">
      {years.map((y) => <li><a href={withBase(`archive/${y.year}/`)}>{y.year === "unknown" ? "Date unknown" : y.year} ({y.total})</a></li>)}
    </ul>
  )}
</Base>
