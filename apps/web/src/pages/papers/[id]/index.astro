---
import Base from "../../../layouts/Base.astro";
import PaperDetail from "../../../components/PaperDetail.astro";
import { aliases, paper, paperIds, taxonomy } from "../../../lib/catalog";
import { withBase } from "../../../lib/urls";
export function getStaticPaths() {
  const live = paperIds().map((id) => ({ params: { id }, props: { id, movedTo: null as string | null } }));
  const moved = Object.entries(aliases()).map(([id, target]) => ({ params: { id }, props: { id, movedTo: target } }));
  return [...live, ...moved];
}
const { id, movedTo } = Astro.props as { id: string; movedTo: string | null };
const current = movedTo ? paper(movedTo) : paper(id);
const related = current.related_work_ids.map((rid) => {
  const other = paper(rid);
  return { id: rid, title: other.title, path: other.canonical_path };
});
---
{movedTo ? (
  <Base title="Moved" canonicalPath={current.canonical_path} noindex>
    <meta slot="head" http-equiv="refresh" content={`0; url=${current.canonical_path}`} />
    <h1>This paper record has moved</h1>
    <p>It was merged with another record. Moved to: <a href={current.canonical_path}>{current.title}</a>.</p>
  </Base>
) : (
  <Base title={current.title} canonicalPath={current.canonical_path}
    description={current.abstract ? current.abstract.slice(0, 200) : undefined}>
    <p class="paper-note"><a href={withBase("")}>Back to the index</a></p>
    <PaperDetail paper={current} taxonomy={taxonomy()} related={related} />
  </Base>
)}
