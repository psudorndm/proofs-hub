---
import Base from "../layouts/Base.astro";
import { status } from "../lib/catalog";
import { withBase } from "../lib/urls";
const s = status();
---
<Base title="Status" canonicalPath={withBase("status/")}>
  <article class="detail">
    <h1>Source status</h1>
    <p>Status as known when this release was published (dataset as of <time datetime={s.as_of_date}>{s.as_of_date}</time>). A static page cannot know about failures after that date.</p>
    <div class="table-wrap"><table>
      <thead><tr><th scope="col">Source</th><th scope="col">Last attempt</th><th scope="col">Last success</th><th scope="col">Coverage</th><th scope="col">Last error</th></tr></thead>
      <tbody>
        {s.sources.map((src: any) => (
          <tr>
            <td>{src.provider}</td>
            <td>{src.last_attempt_at ? src.last_attempt_at.slice(0, 10) : "Never"}</td>
            <td>{src.last_success_at ? src.last_success_at.slice(0, 10) : "Never"}</td>
            <td>{src.coverage_state.replace("_", " ")}</td>
            <td>{src.last_error_code ? src.last_error_code.replaceAll("_", " ") : "—"}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </article>
</Base>
