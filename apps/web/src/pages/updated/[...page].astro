---
import ListView from "../../components/ListView.astro";
import { listPages } from "../../lib/catalog";
import { pagedPaths } from "../../lib/paths";
import type { ListPage } from "../../lib/contracts";
export function getStaticPaths() { return pagedPaths(listPages("lists/updated")); }
const { page } = Astro.props as { page: ListPage };
---
<ListView page={page} prefix="updated" view="updated" title="Updated papers" heading="Updated papers"
  context={`latest source revision or metadata update in the last ${page.window_days} days`}
  intro="Updates are new source versions, metadata corrections, withdrawals, or restorations. Reclassification and bookkeeping changes are not listed." />
