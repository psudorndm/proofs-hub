---
import Base from "../../layouts/Base.astro";
import SearchPanel from "../../components/SearchPanel.astro";
import { withBase } from "../../lib/urls";
---
<Base title="Search" canonicalPath={withBase("search/")}>
  <SearchPanel view="search" />
  <section class="results" aria-labelledby="results-heading" data-search-results>
    <div class="list-head"><h2 id="results-heading">Search</h2><p class="meta" aria-live="polite" data-result-count></p></div>
    <noscript><p class="empty">Search needs JavaScript. You can still <a href={withBase("archive/")}>browse the archive</a>, <a href={withBase("topics/")}>topics</a>, and <a href={withBase("foundations/")}>foundations</a>.</p></noscript>
  </section>
  <script>
    import { startSearch } from "../../lib/search-controller";
    import { SEARCH_FAILED } from "../../lib/format";
    const releaseId = document.querySelector<HTMLMetaElement>('meta[name="proof-index-release"]')!.content;
    const base = document.querySelector<HTMLMetaElement>('meta[name="proof-index-base"]')!.content;
    const asset = (rel: string) => `${base}assets/releases/${encodeURIComponent(releaseId)}/${rel}`;
    Promise.all([fetch(asset("search-facets.json")), fetch(asset("taxonomy.json"))])
      .then(async ([f, t]) => {
        if (!f.ok || !t.ok) throw new Error("missing search data");
        const facets = await f.json();
        if (facets.release_id !== releaseId) throw new Error("release mismatch");
        startSearch({ releaseId, base, facets, taxonomy: await t.json() });
      })
      .catch(() => {
        const count = document.querySelector<HTMLElement>("[data-result-count]");
        if (count) count.textContent = SEARCH_FAILED;
      });
  </script>
</Base>
