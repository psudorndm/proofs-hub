---
import Base from "../layouts/Base.astro";
import CoverageTable from "../components/CoverageTable.astro";
import { coverage, manifest } from "../lib/catalog";
import { withBase } from "../lib/urls";
const c = coverage();
const m = manifest();
const vis = c.relevance.works_by_visibility as Record<string, number>;
---
<Base title="Coverage" canonicalPath={withBase("coverage/")}>
  <article class="detail">
    <h1>Coverage</h1>
    <p>Overall historical coverage: <strong>{c.coverage_status.replace("_", " ")}</strong> (as of {c.as_of_date}).</p>
    <p class="paper-note">{c.notes}</p>
    <section><h2>Source coverage</h2><CoverageTable rows={c.streams} /></section>
    <section>
      <h2>Relevance review coverage</h2>
      <p class="paper-note">Source coverage and relevance review are separate: a fully harvested source can still have records awaiting review.</p>
      <dl>
        <dt>Published works</dt><dd>{m.included_work_count}</dd>
        <dt>Works awaiting review</dt><dd>{vis.review ?? 0}</dd>
        <dt>Works not included</dt><dd>{vis.excluded ?? 0}</dd>
        <dt>Source records</dt><dd>{c.relevance.source_records_total}</dd>
        <dt>Source records classified</dt><dd>{c.relevance.source_records_classified}</dd>
      </dl>
    </section>
  </article>
</Base>
