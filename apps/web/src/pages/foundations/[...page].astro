---
import ListView from "../../components/ListView.astro";
import { listPages } from "../../lib/catalog";
import { pagedPaths } from "../../lib/paths";
import type { ListPage } from "../../lib/contracts";
export function getStaticPaths() { return pagedPaths(listPages("lists/foundations")); }
const { page } = Astro.props as { page: ListPage };
---
<ListView page={page} prefix="foundations" view="foundations" title="Foundations" heading="Foundational papers"
  intro="A curated collection across all three areas, with no age cutoff. Foundational status is an explicit curation decision, not inferred from age or citations." />
