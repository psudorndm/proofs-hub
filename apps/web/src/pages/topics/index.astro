---
import Base from "../../layouts/Base.astro";
import { manifest, taxonomy } from "../../lib/catalog";
import { withBase } from "../../lib/urls";
const tax = taxonomy();
const counts = manifest().topic_counts;
---
<Base title="Topics" canonicalPath={withBase("topics/")}>
  <h1>Topics</h1>
  {tax.areas.map((area) => (
    <section>
      <h2>{area.display_name}</h2>
      <ul>
        {tax.topics.filter((t) => t.areas.includes(area.id)).map((t) => (
          <li><a href={withBase(`topics/${t.id}/`)}>{t.display_name}</a> ({counts[t.id] ?? 0})</li>
        ))}
      </ul>
    </section>
  ))}
</Base>
